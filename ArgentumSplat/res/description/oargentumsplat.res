CONTAINER Oargentumsplat
{
NAME Oargentumsplat;
INCLUDE Obase;
GROUP ID_OBJECTPROPERTIES
{
GROUP IMAGE_GROUP { DEFAULT 1;
FILENAME AS_IMAGE {  }
LONG AS_INPUT_MODE { CYCLE { AS_INPUT_AUTO; AS_INPUT_SEQUENCE; } ANIM OFF; }
LONG AS_SOURCE_FRAME { MIN 0; MAX 99999; ANIM OFF; }
BUTTON AS_PREVIEW_SOURCE {  }
LONG AS_NUM_GAUSSIANS { CYCLE { AS_COUNT_LOW; AS_COUNT_MED; AS_COUNT_HIGH; } }
LONG AS_STEPS { MIN 1; MAX 100; }
LONG AS_SEED { MIN 0; MAX 2147483647; }
LONG AS_ALPHA_EROSION { MIN 0; MAX 8; }
FILENAME AS_OUTPUT_DIR { DIRECTORY; }
BUTTON AS_GENERATE {  }
BUTTON AS_CANCEL {  }
BUTTON AS_SETUP {  }
BUTTON AS_OPEN_OUTPUT {  }
}
GROUP SCAN_GROUP { DEFAULT 1;
FILENAME AS_FILE {  }
LONG AS_SH_DEGREE { CYCLE { AS_SH_OFF; AS_SH_ONE; AS_SH_TWO; AS_SH_THREE; } }
BOOL AS_CAMERA_FACING {  }
LINK AS_CAMERA { ACCEPT { Obase; } }
BOOL AS_SPZ_RAW {  }
LONG AS_SMOOTHING { MIN 0; MAX 8; }
BUTTON AS_INITIALISE {  }
BUTTON AS_DETAIL_PRESET {  }
BUTTON AS_PREPARE_REDSHIFT {  }
BUTTON AS_SOURCE_CAMERA {  }
}
GROUP LOOK_GROUP { DEFAULT 1;
LONG AS_COLOR_MODE { CYCLE { AS_COLOR_VIEWER; AS_COLOR_LINEAR; } }
REAL AS_HIGHLIGHT { MIN 0.01; MAX 16; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SH_STRENGTH { MIN 0; MAX 3; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_EMISSION { MIN 0; MAX 5; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_DIFFUSE { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SUBSURFACE { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
}
GROUP COLOR_GROUP { DEFAULT 1;
REAL AS_GAMMA { MIN 0.05; MAX 4; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_CONTRAST { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_HUE { MIN -180; MAX 180; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SATURATION { MIN 0; MAX 3; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_LEVEL { MIN 0; MAX 5; CUSTOMGUI REALSLIDER; STEP 0.1; }
}
GROUP VIEW_GROUP { DEFAULT 1;
BOOL AS_POINT_PREVIEW {  }
LONG AS_PREVIEW_COUNT { MIN 0; MAX 1000000; }
}
GROUP ADVANCED_GROUP { DEFAULT 0;
REAL AS_SCALE { MIN 0.0001; MAX 100000; STEP 0.1; }
REAL AS_PIXEL_VARIANCE { MIN 0; MAX 2; STEP 0.025; }
REAL AS_SPLAT_SCALE { MIN 0.01; MAX 10; CUSTOMGUI REALSLIDER; STEP 0.1; }
LONG AS_MAX_SPLATS { MIN 1; MAX 3000000; }
REAL AS_MIN_OPACITY { MIN 0; MAX 1; STEP 0.001; }
REAL AS_OPACITY { MIN 0; MAX 2; CUSTOMGUI REALSLIDER; STEP 0.1; }
BOOL AS_FLIP_Y {  }
LINK AS_MATERIAL { ACCEPT { Mbase; } }
BUTTON AS_MOGRAPH {  }
}
GROUP STATUS_GROUP { DEFAULT 1;
STRING AS_STATUS { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
BUTTON AS_SUPPORT_AUTHOR { ANIM OFF; }
}
}
}
