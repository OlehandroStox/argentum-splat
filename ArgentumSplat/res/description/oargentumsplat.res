CONTAINER Oargentumsplat
{
NAME Oargentumsplat;
INCLUDE Obase;
GROUP IMAGE_GROUP {
STRING AS_STATUS_IMAGE { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
STRING AS_IMAGE_HINT { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
FILENAME AS_IMAGE {  }
BUTTON AS_PREVIEW_SOURCE {  }
LONG AS_GAUSSIAN_PRESET { CYCLE { AS_COUNT_LOW; AS_COUNT_MED; AS_COUNT_HIGH; AS_COUNT_ULTRA; AS_COUNT_MILLION; AS_COUNT_CUSTOM; } }
LONG AS_NUM_GAUSSIANS { MIN 32768; MAX 1048576; STEP 32; }
LONG AS_STEPS { MIN 1; MAX 100; }
LONG AS_SEED { MIN 0; MAX 2147483647; }
LONG AS_ALPHA_EROSION { MIN 0; MAX 8; }
FILENAME AS_OUTPUT_DIR { DIRECTORY; }
BUTTON AS_GENERATE {  }
BUTTON AS_CANCEL {  }
BUTTON AS_SETUP {  }
BUTTON AS_OPEN_OUTPUT {  }
}
GROUP PHOTOS_GROUP {
STRING AS_STATUS_PHOTOS { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
STRING AS_PHOTOS_HINT { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
FILENAME AS_PHOTOS_FOLDER { DIRECTORY; }
LONG AS_PHOTOS_COLOR { CYCLE { AS_PHOTOS_LINEAR; AS_PHOTOS_SRGB; } ANIM OFF; }
LONG AS_PHOTOS_STEPS { MIN 100; MAX 60000; STEP 100; ANIM OFF; }
LONG AS_PHOTOS_MAX_SPLATS { MIN 10000; MAX 4000000; STEP 10000; ANIM OFF; }
LONG AS_PHOTOS_RESOLUTION { MIN 512; MAX 2400; STEP 64; ANIM OFF; }
FILENAME AS_PHOTOS_OUTPUT { DIRECTORY; }
BUTTON AS_PHOTOS_GENERATE { }
BUTTON AS_PHOTOS_CANCEL { }
BUTTON AS_PHOTOS_SETUP { }
BUTTON AS_PHOTOS_OPEN { }
LONG AS_CAPTURE_INDEX { MIN 0; MAX 499; ANIM OFF; }
BUTTON AS_CAPTURE_VIEW { ANIM OFF; }
STRING AS_PHOTOS_REPORT { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
}
GROUP SCAN_GROUP {
STRING AS_STATUS_SCAN { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
FILENAME AS_FILE {  }
LONG AS_IMPORT_QUALITY { CYCLE { AS_QUALITY_CUSTOM; AS_QUALITY_LOW; AS_QUALITY_MEDIUM; AS_QUALITY_HIGH; AS_QUALITY_MAX; } ANIM OFF; }
STRING AS_IMPORT_PLAN { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
BOOL AS_ASK_LARGE_IMPORT { DEFAULT 0; ANIM OFF; }
LONG AS_SH_DEGREE { CYCLE { AS_SH_OFF; AS_SH_ONE; AS_SH_TWO; AS_SH_THREE; } }
BOOL AS_CAMERA_FACING {  }
LINK AS_CAMERA { ACCEPT { Obase; } }
BOOL AS_SPZ_RAW {  }
LONG AS_SMOOTHING { MIN 0; MAX 8; }
BUTTON AS_INITIALISE {  }
BOOL AS_AUTO_REDSHIFT { ANIM OFF; }
BOOL AS_AUTO_FRAME { ANIM OFF; }
GROUP SCAN_TOOLS_GROUP { DEFAULT 0;
BUTTON AS_DETAIL_PRESET {  }
BUTTON AS_FRAME_SCAN { ANIM OFF; }
BUTTON AS_PREPARE_REDSHIFT {  }
BUTTON AS_SOURCE_CAMERA {  }
}
}
GROUP ID_OBJECTPROPERTIES
{
GROUP STATUS_GROUP { DEFAULT 1;
STRING AS_STATUS { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
STRING AS_SOURCE_INFO { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
BUTTON AS_SUPPORT_AUTHOR { ANIM OFF; }
BUTTON AS_GITHUB { ANIM OFF; }
}
GROUP LOOK_GROUP { DEFAULT 1;
LONG AS_COLOR_MODE { CYCLE { AS_COLOR_VIEWER; AS_COLOR_LINEAR; } }
REAL AS_HIGHLIGHT { MIN 0.01; MAX 16; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SH_STRENGTH { MIN 0; MAX 3; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_EMISSION { MIN 0; MAX 5; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_DIFFUSE { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SUBSURFACE { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
}
GROUP COLOR_GROUP { DEFAULT 1;
REAL AS_GAMMA { MIN 0.05; MAX 4; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_CONTRAST { MIN 0; MAX 1; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_HUE { MIN -180; MAX 180; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_SATURATION { MIN 0; MAX 3; CUSTOMGUI REALSLIDER; STEP 0.1; }
REAL AS_LEVEL { MIN 0; MAX 5; CUSTOMGUI REALSLIDER; STEP 0.1; }
}
GROUP VIEW_GROUP { DEFAULT 1;
BOOL AS_POINT_PREVIEW {  }
LONG AS_PREVIEW_COUNT { MIN 0; MAX 1000000; DEFAULT 50000; }
}
GROUP ADVANCED_GROUP { DEFAULT 0;
REAL AS_SCALE { MIN 0.0001; MAX 100000; STEP 0.1; }
REAL AS_PIXEL_VARIANCE { MIN 0; MAX 2; STEP 0.025; }
REAL AS_SPLAT_SCALE { MIN 0.01; MAX 10; CUSTOMGUI REALSLIDER; STEP 0.1; }
LONG AS_MAX_SPLATS { MIN 0; MAX 100000000; ANIM OFF; }
REAL AS_MIN_OPACITY { MIN 0; MAX 1; STEP 0.001; }
REAL AS_OPACITY { MIN 0; MAX 2; CUSTOMGUI REALSLIDER; STEP 0.1; }
BOOL AS_FLIP_Y {  }
BOOL AS_AUTO_SOG_ORIENTATION { DEFAULT 1; ANIM OFF; }
LINK AS_MATERIAL { ACCEPT { Mbase; } }
BUTTON AS_MOGRAPH {  }
}

}
GROUP HELP_GROUP
{
STRING AS_STATUS_HELP { CUSTOMGUI MULTISTRING; READONLY; ANIM OFF; }
BUTTON AS_HELP_READER { ANIM OFF; }
GROUP HELP_SETTINGS_GROUP {
LONG AS_HELP_LANGUAGE { CYCLE { AS_HELP_EN; AS_HELP_RU; } ANIM OFF; }
LONG AS_HELP_TOPIC { CYCLE { } ANIM OFF; }
}
GROUP HELP_BODY_GROUP {
COLUMNS 1;
STRING AS_HELP_TEXT { READONLY; ANIM OFF; }
}
GROUP HELP_FOOTER_GROUP {
BUTTON AS_HELP_SUPPORT { ANIM OFF; }
BUTTON AS_HELP_GITHUB { ANIM OFF; }
STATICTEXT AS_VERSION_INFO { ANIM OFF; }
}
}
}
